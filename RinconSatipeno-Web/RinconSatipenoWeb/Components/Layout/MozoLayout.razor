@inherits LayoutComponentBase
@inject RinconSatipenoWeb.Servicios.Rest.SesionEmpleadoService Sesion
@inject RinconSatipenoWeb.Servicios.Rest.AtencionApiService Api
@inject NavigationManager Navegacion

@if (Sesion.EsMozo)
{
<div class="rs-admin-shell">
    <aside class="rs-admin-sidebar">
        <a class="rs-admin-brand" href="/atencion/mozo">
            <span class="rs-admin-brand-mark">✦</span>
            <span>El Rincón <strong>Satipeño</strong><small>Servicio de salón</small></span>
        </a>
        <div class="rs-admin-menu-title">MI JORNADA</div>
        <nav class="nav flex-column rs-admin-menu" aria-label="Navegación del mozo">
            <NavLink class="nav-link" href="/atencion/mozo" Match="NavLinkMatch.All">
                <i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"></i>Mis mesas
            </NavLink>
        </nav>
        <div class="rs-admin-sidebar-foot small">
            <div class="mb-2">@Sesion.Sesion?.Nombre</div>
            <button type="button" class="btn btn-outline-light btn-sm w-100" @onclick="Salir">
                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión
            </button>
        </div>
    </aside>
    <div class="rs-admin-content">
        <header class="rs-admin-topbar d-flex align-items-center justify-content-between gap-3">
            <div class="fw-semibold rs-admin-top-title">El Rincón Satipeño <span class="fw-normal text-secondary">/ Salón</span></div>
            <span class="rs-admin-user"><i class="bi bi-person-circle me-1" aria-hidden="true"></i>@Sesion.Sesion?.Nombre</span>
        </header>
        <main class="rs-admin-main container-fluid">
            @Body
        </main>
    </div>
</div>

}
else
{
    <div class="container py-5 text-center"><p>No tienes permisos para acceder al panel del mozo.</p></div>
}
@code {
    protected override void OnInitialized()
    {
        if (!Sesion.EsMozo)
            Navegacion.NavigateTo(Sesion.EstaAutenticado ? "/acceso-denegado" : "/empleados/login");
    }

    private async Task Salir()
    {
        try { await Api.CerrarSesionAsync(); } catch { Sesion.Cerrar(); }
        Navegacion.NavigateTo("/empleados/login", true);
    }
}
