@page "/atencion/mesa/{Id:int}"
@layout MozoLayout
@using RinconSatipenoWeb.Models.Atencion
@using RinconSatipenoWeb.ViewModels
@inject AtencionApiService Api

<PageTitle>Atención de mesa | El Rincón Satipeño</PageTitle>

@if (cargando)
{
    <p class="text-secondary">Cargando atención...</p>
}
else if (mesa is null)
{
    <div class="rs-atn-card p-4">
        <h1>Mesa no disponible</h1>
        <p>La mesa no existe o no está asignada a tu cuenta.</p>
        <a href="/atencion/mozo" class="btn rs-btn-primary">Volver a mis mesas</a>
    </div>
}
else
{
    <div class="rs-atn-heading d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="rs-atn-overline">SALÓN · PEDIDOS</div>
            <h1>Atención de mesa @mesa.Numero.ToString("00")</h1>
            <p class="text-secondary mb-0">@ZonaTexto(mesa.Zona) · Mozo: @mesa.Mozo</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="rs-atn-pill rs-atn-busy">Ocupada</span>
            <a class="btn rs-btn-outline" href="/atencion/mozo">← Volver</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(aviso))
    {
        <div class="alert @(error ? "alert-danger" : "alert-success")" role="status">@aviso</div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            @if (mesa.Estado == "OCUPADA" && cuenta?.Estado != "PENDIENTE" && cuenta?.Estado != "PAGADA")
            {
                <section class="rs-atn-card p-3 p-md-4 mb-4">
                    <h2 class="h5 mb-1">Agregar al pedido</h2>
                    <p class="text-secondary small mb-3">Selecciona el plato o bebida y registra la cantidad solicitada.</p>
                    @if (platos.Count == 0)
                    {
                        <p class="text-secondary">No hay platos disponibles.</p>
                    }
                    else
                    {
                        <EditForm Model="pedido" OnValidSubmit="AgregarPedido">
                            <DataAnnotationsValidator />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label" for="producto">Plato o bebida</label>
                                    <InputSelect id="producto" class="form-select" @bind-Value="pedido.IdPlato">
                                        @foreach (var producto in platos)
                                        {
                                            <option value="@producto.Id">@producto.Nombre — S/ @producto.Precio.ToString("0.00")</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => pedido.IdPlato)" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label" for="cantidad">Cantidad</label>
                                    <InputNumber id="cantidad" class="form-control" min="1" max="20" @bind-Value="pedido.Cantidad" />
                                    <ValidationMessage For="@(() => pedido.Cantidad)" />
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn rs-btn-primary w-100" disabled="@procesando">+ Agregar pedido</button>
                                </div>
                            </div>
                        </EditForm>
                    }
                </section>
            }
            else if (mesa.Estado != "OCUPADA")
            {
                <div class="alert alert-secondary">La mesa no tiene una atención activa.</div>
            }
            else
            {
                <div class="alert alert-info">Esta cuenta ya tiene un QR de pago generado. No se pueden agregar más consumos.</div>
            }

            <section class="rs-atn-card p-3 p-md-4">
                <div class="d-flex justify-content-between gap-2 align-items-center mb-3">
                    <div><h2 class="h5 mb-1">Consumo de la mesa</h2><p class="text-secondary small mb-0">Detalle de productos solicitados</p></div>
                    <span class="rs-atn-pill rs-atn-neutral">@cuenta?.Detalles.Sum(d => d.Cantidad) unidades</span>
                </div>
                <div class="table-responsive">
                    <table class="table rs-atn-table align-middle mb-0">
                        <thead><tr><th>Producto</th><th class="text-center">Cantidad</th><th class="text-end">P. unitario</th><th class="text-end">Importe</th></tr></thead>
                        <tbody>
                            @foreach (var detalle in cuenta?.Detalles ?? new())
                            {
                                <tr>
                                    <td class="fw-semibold">@detalle.Nombre</td>
                                    <td class="text-center">@detalle.Cantidad</td>
                                    <td class="text-end">S/ @detalle.PrecioUnitario.ToString("0.00")</td>
                                    <td class="text-end fw-semibold">S/ @detalle.Importe.ToString("0.00")</td>
                                </tr>
                            }
                            @if (cuenta is null || cuenta.Detalles.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-secondary py-4">Aún no se han agregado productos a esta mesa.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-xl-4">
            <aside class="rs-atn-card p-4 rs-atn-sticky">
                <h2 class="h5 mb-3">Resumen de atención</h2>
                <div class="rs-atn-mesa-detail"><span>Mesa</span><strong>@mesa.Numero.ToString("00")</strong></div>
                <div class="rs-atn-mesa-detail"><span>Zona</span><strong>@ZonaTexto(mesa.Zona)</strong></div>
                <div class="rs-atn-mesa-detail"><span>Unidades solicitadas</span><strong>@(cuenta?.Detalles.Sum(d => d.Cantidad) ?? 0)</strong></div>
                <hr />
                <div class="d-flex align-items-center justify-content-between mb-4"><span>Total de consumo</span><strong class="rs-atn-total">S/ @((cuenta?.Total ?? 0).ToString("0.00"))</strong></div>
                @if (cuenta?.Estado == "PENDIENTE")
                {
                    <a class="btn rs-btn-gold w-100 mb-2" href="@($"/atencion/pago/{Id}?token={Uri.EscapeDataString(cuenta.Referencia ?? "")}")">Mostrar QR al cliente →</a>
                }
                else if (cuenta is not null && cuenta.Detalles.Count > 0)
                {
                    <a class="btn rs-btn-gold w-100 mb-2" href="@($"/atencion/cuenta/{Id}")">Preparar cuenta →</a>
                }
                else
                {
                    <button class="btn btn-secondary w-100 mb-2" disabled>Cuenta no disponible</button>
                }
                <a class="btn rs-btn-outline w-100" href="/atencion/mozo">Volver a mis mesas</a>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private MesaAtencionDTO? mesa;
    private CuentaConsumoDTO? cuenta;
    private List<ProductoAtencionDTO> platos = new();
    private PedidoViewModel pedido = new();
    private string aviso = "";
    private bool error;
    private bool cargando = true;
    private bool procesando;

    protected override async Task OnParametersSetAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var mesas = await Api.ObtenerMesasAsync();
            mesa = mesas.FirstOrDefault(m => m.Id == Id);
            platos = await Api.ObtenerPlatosAsync();
            if (platos.Count > 0 && pedido.IdPlato == 0)
                pedido.IdPlato = platos[0].Id;

            cuenta = null;
            if (mesa is not null)
            {
                try { cuenta = await Api.ObtenerCuentaAsync(Id); }
                catch (InvalidOperationException) { }
            }
        }
        catch (Exception ex)
        {
            aviso = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AgregarPedido()
    {
        aviso = "";
        error = false;
        procesando = true;
        try
        {
            await Api.AgregarPedidoAsync(Id, pedido.IdPlato, pedido.Cantidad);
            pedido.Cantidad = 1;
            await CargarDatos();
            aviso = "El pedido se registró correctamente.";
        }
        catch (Exception ex)
        {
            aviso = ex.Message;
            error = true;
        }
        finally
        {
            procesando = false;
        }
    }

    private static string ZonaTexto(string zona) => zona == "SALON_PRINCIPAL" ? "Salón principal" : "Terraza";
}
