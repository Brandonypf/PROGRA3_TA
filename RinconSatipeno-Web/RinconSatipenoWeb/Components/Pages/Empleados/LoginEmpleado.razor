@page "/empleados/login"
@layout AccesoLayout
@inject RinconSatipenoWeb.Components.Pages.Atencion.EstadoAtencion Estado
@inject NavigationManager Navegacion

<PageTitle>Ingreso de empleados | El Rincón Satipeño</PageTitle>

<section class="p4-login-card" aria-labelledby="p4LoginTitulo">
    <div class="p4-login-aside">
        <div>
            <span class="p4-login-kicker">✦ GESTIÓN DEL RESTAURANTE</span>
            <h2 class="mt-4 mb-3">Bienvenido a nuestro equipo.</h2>
            <p>Un mismo espacio para organizar el trabajo diario y consultar la información del restaurante.</p>
        </div>
        <div class="p4-login-aside-bottom">El Rincón Satipeño · Plataforma interna</div>
    </div>
    <div class="p4-login-form">
        <span class="p4-eyebrow">ACCESO DE PERSONAL</span>
        <h1 id="p4LoginTitulo" class="mt-2 mb-2">Iniciar sesión</h1>
        <p class="mb-4">Ingresa tus datos y selecciona tu área de trabajo.</p>
        <div class="mb-3">
            <label for="p4Usuario" class="form-label">Usuario</label>
            <input id="p4Usuario" class="form-control" type="text" placeholder="Ingresa tu usuario" autocomplete="username" @bind="usuario" />
        </div>
        <div class="mb-3">
            <label for="p4Clave" class="form-label">Contraseña</label>
            <input id="p4Clave" class="form-control" type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" @bind="clave" />
        </div>
        <div class="mb-3">
            <label for="p4Rol" class="form-label">Área de trabajo</label>
            <select id="p4Rol" class="form-select" @bind="area">
                <option value="Administrador">Administrador</option>
                <option value="Mozo">Mesero</option>
            </select>
        </div>
        @if (area == "Mozo")
        {
            <div class="mb-3">
                <label for="p4Personal" class="form-label">Personal del turno</label>
                <select id="p4Personal" class="form-select" @bind="mozo">
                    @foreach (var empleado in Estado.Mozos)
                    {
                        <option value="@empleado">@empleado</option>
                    }
                </select>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(aviso))
        {
            <div class="alert alert-danger small" role="alert">@aviso</div>
        }
        <button type="button" class="btn p4-btn-primary w-100 py-3" @onclick="Ingresar">Iniciar sesión</button>
    </div>
</section>

@code {
    private string usuario = "";
    private string clave = "";
    private string area = "Administrador";
    private string mozo = "Lucía Ramos";
    private string aviso = "";

    private void Ingresar()
    {
        Estado.Ingresar(area, mozo);
        Navegacion.NavigateTo(area == "Mozo" ? "/atencion/mozo" : "/admin/mesas/estado");
    }
}
