@page "/admin/insumos"

<PageTitle>Gestión de insumos | El Rincón Satipeño</PageTitle>
<HeadContent><link rel="stylesheet" href="/css/p3.css" /></HeadContent>

<div class="p3-page container-fluid py-4 px-3 px-lg-4">
    <nav aria-label="Ubicación" class="small mb-2"><a href="/">Inicio</a> / Administración / Insumos</nav>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="p3-title mb-1">Gestión de insumos</h1><p class="p3-subtitle mb-0">Control de existencias y unidades de medida.</p></div>
        <button type="button" class="btn p3-btn-primary" data-bs-toggle="modal" data-bs-target="#p3NuevoInsumo">+ Registrar insumo</button>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="p3-stat"><span>Insumos registrados</span><strong>@insumos.Count</strong><small>En el inventario</small></div></div>
        <div class="col-md-4"><div class="p3-stat"><span>Stock suficiente</span><strong>@(insumos.Count(i => i.StockActual > i.StockMinimo))</strong><small>Por encima del mínimo</small></div></div>
        <div class="col-md-4"><div class="p3-stat p3-stat-warning"><span>En nivel mínimo o menor</span><strong>@(insumos.Count(i => i.StockActual <= i.StockMinimo))</strong><small>Requieren revisión</small></div></div>
    </div>
    <section class="p3-card mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-5"><label for="p3BuscarInsumo" class="form-label">Buscar insumo</label><input id="p3BuscarInsumo" class="form-control" placeholder="Arroz, plátano, aceite..." @bind="busqueda" @bind:event="oninput" /></div>
            <div class="col-md-4"><label for="p3FiltroStock" class="form-label">Estado de stock</label><select id="p3FiltroStock" class="form-select" @bind="estado"><option value="">Todos</option><option value="suficiente">Suficiente</option><option value="minimo">En mínimo</option><option value="bajo">Por debajo del mínimo</option></select></div>
            <div class="col-md-3 d-flex gap-2"><button type="button" class="btn p3-btn-outline flex-fill" @onclick="AplicarFiltros">Buscar</button><button type="button" class="btn btn-light border flex-fill" @onclick="LimpiarFiltros">Limpiar</button></div>
        </div>
    </section>
    <section class="p3-card p-0 overflow-hidden">
        <div class="p3-table-title d-flex justify-content-between align-items-center gap-2"><h2 class="h6 mb-0">Inventario actual</h2><span class="text-secondary small">@InsumosFiltrados.Count de @insumos.Count insumos</span><a href="/admin/inventario/alertas" class="p3-link small">Ver alertas →</a></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0 p3-table">
            <thead><tr><th>ID</th><th>Insumo</th><th>Unidad</th><th>Stock actual</th><th>Stock mínimo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @foreach (var insumo in InsumosFiltrados)
                {
                    <tr>
                        <td>@insumo.Codigo</td><td class="fw-semibold">@insumo.Nombre</td><td>@insumo.Unidad</td>
                        <td>@insumo.StockActual.ToString("0.##")</td><td>@insumo.StockMinimo.ToString("0.##")</td>
                        <td><span class="p3-tag @EtiquetaStock(insumo)">@NombreEstado(insumo)</span></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm p3-btn-edit me-1" @onclick="() => SeleccionarInsumo(insumo)" data-bs-toggle="modal" data-bs-target="#p3EditarInsumo">Editar</button>
                            <button type="button" class="btn btn-sm p3-btn-danger" @onclick="() => SeleccionarInsumo(insumo)" data-bs-toggle="modal" data-bs-target="#p3EliminarInsumo">Eliminar</button>
                        </td>
                    </tr>
                }
                @if (InsumosFiltrados.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No se encontraron insumos con los filtros seleccionados.</td></tr>
                }
            </tbody>
        </table></div>
    </section>
    <div class="d-flex flex-wrap gap-2 mt-4"><a href="/admin/inventario/movimientos" class="btn p3-btn-outline">Ver movimientos →</a><a href="/admin/inventario/alertas" class="btn p3-btn-outline">Alertas de stock →</a><a href="/admin/recetas" class="btn btn-link p3-link">← Volver a recetas</a></div>
</div>

<div class="modal fade" id="p3NuevoInsumo" tabindex="-1" aria-labelledby="p3NuevoInsumoTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content p3-modal">
    <div class="modal-header"><h2 class="modal-title fs-5" id="p3NuevoInsumoTitulo">Registrar insumo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <div class="mb-3"><label for="p3NuevoInsumoNombre" class="form-label">Nombre</label><input id="p3NuevoInsumoNombre" class="form-control" placeholder="Arroz" /></div>
        <div class="mb-3"><label for="p3NuevaUnidad" class="form-label">Unidad de medida</label><select id="p3NuevaUnidad" class="form-select"><option>Seleccione...</option><option>kg</option><option>g</option><option>L</option><option>unidades</option></select></div>
        <div class="row g-3"><div class="col-6"><label for="p3NuevoStock" class="form-label">Stock actual</label><input id="p3NuevoStock" class="form-control" type="number" min="0" step="0.01" placeholder="0" /></div><div class="col-6"><label for="p3NuevoMinimo" class="form-label">Stock mínimo</label><input id="p3NuevoMinimo" class="form-control" type="number" min="0" step="0.01" placeholder="0" /></div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn p3-btn-primary" data-bs-dismiss="modal">Guardar</button></div>
</div></div></div>
<div class="modal fade" id="p3EditarInsumo" tabindex="-1" aria-labelledby="p3EditarInsumoTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content p3-modal">
    <div class="modal-header"><h2 class="modal-title fs-5" id="p3EditarInsumoTitulo">Editar insumo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">
        <div class="mb-3"><label for="p3EditarInsumoNombre" class="form-label">Nombre</label><input id="p3EditarInsumoNombre" class="form-control" value="@insumoSeleccionado?.Nombre" /></div>
        <div class="mb-3"><label for="p3EditarUnidad" class="form-label">Unidad de medida</label><select id="p3EditarUnidad" class="form-select" value="@insumoSeleccionado?.Unidad"><option>kg</option><option>g</option><option>L</option><option>unidades</option></select></div>
        <div class="row g-3"><div class="col-6"><label for="p3EditarStock" class="form-label">Stock actual</label><input id="p3EditarStock" class="form-control" type="number" step="0.01" value="@insumoSeleccionado?.StockActual" /></div><div class="col-6"><label for="p3EditarMinimo" class="form-label">Stock mínimo</label><input id="p3EditarMinimo" class="form-control" type="number" step="0.01" value="@insumoSeleccionado?.StockMinimo" /></div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn p3-btn-primary" data-bs-dismiss="modal">Guardar</button></div>
</div></div></div>
<div class="modal fade" id="p3EliminarInsumo" tabindex="-1" aria-labelledby="p3EliminarInsumoTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content p3-modal">
    <div class="modal-header"><h2 class="modal-title fs-5" id="p3EliminarInsumoTitulo">Eliminar insumo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
    <div class="modal-body">¿Deseas eliminar el insumo <strong>@insumoSeleccionado?.Nombre</strong>?</div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn p3-btn-danger" data-bs-dismiss="modal">Eliminar</button></div>
</div></div></div>

@code {
    private string busqueda = "";
    private string estado = "";
    private string busquedaAplicada = "";
    private string estadoAplicado = "";
    private InsumoDato? insumoSeleccionado;

    private readonly List<InsumoDato> insumos = new()
    {
        new("INS-01", "Cecina", "kg", 12.50m, 5.00m),
        new("INS-02", "Plátano bellaco", "unidades", 14m, 20m),
        new("INS-03", "Arroz", "kg", 25.00m, 10.00m),
        new("INS-04", "Aceite vegetal", "L", 3.00m, 3.00m),
        new("INS-05", "Sal", "kg", 6.00m, 2.00m),
        new("INS-06", "Hoja de bijao", "unidades", 8m, 15m),
        new("INS-07", "Tomates", "kg", 2.00m, 4.00m),
        new("INS-08", "Manteca", "kg", 8m, 2m),
        new("INS-09", "Gallina", "kg", 18m, 6m),
        new("INS-10", "Huevo", "unidades", 40m, 15m),
        new("INS-11", "Lechuga", "kg", 5m, 2m),
        new("INS-12", "Harina", "kg", 22m, 8m),
        new("INS-13", "Queso", "kg", 7m, 3m)
    };

    private List<InsumoDato> InsumosFiltrados => insumos.Where(i =>
        (string.IsNullOrWhiteSpace(busquedaAplicada) || i.Nombre.Contains(busquedaAplicada, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(estadoAplicado) || EstadoStock(i) == estadoAplicado)).ToList();

    private static string EstadoStock(InsumoDato i) => i.StockActual < i.StockMinimo ? "bajo" : i.StockActual == i.StockMinimo ? "minimo" : "suficiente";
    private static string NombreEstado(InsumoDato i) => EstadoStock(i) switch { "bajo" => "Bajo mínimo", "minimo" => "En mínimo", _ => "Suficiente" };
    private static string EtiquetaStock(InsumoDato i) => EstadoStock(i) switch { "bajo" => "p3-tag-danger", "minimo" => "p3-tag-gold", _ => "p3-tag-green" };

    private void AplicarFiltros()
    {
        busquedaAplicada = busqueda.Trim();
        estadoAplicado = estado;
    }

    private void LimpiarFiltros()
    {
        busqueda = "";
        estado = "";
        AplicarFiltros();
    }

    private void SeleccionarInsumo(InsumoDato insumo) => insumoSeleccionado = insumo;

    private record InsumoDato(string Codigo, string Nombre, string Unidad, decimal StockActual, decimal StockMinimo);
}
